# ==============================================================================
# KDS Monorepo Backend Environment Variables
# ==============================================================================

# Server configuration
PORT=8000
API_PORT=8000
RUST_LOG=info,api_server=debug,tower_http=debug,scan_worker=debug

# Security
JWT_SECRET=super_secret_jwt_key_production_grade_security_2026

# Database (PostgreSQL)
DB_PORT=5432
POSTGRES_USER=appsec
POSTGRES_PASSWORD=appsec_password
POSTGRES_DB=appsec_db
DATABASE_URL=postgres://appsec:appsec_password@localhost:5432/appsec_db

# Cache & PubSub (Redis)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# OWASP ZAP Scanner
ZAP_PORT=8080
ZAP_URL=http://localhost:8080
ZAP_API_KEY=zap_secret_api_key_2026

